        let req = make_request(
            &record(),
            Method::GET,
            &[
                "func-bm7-forum-prod",
                "Forum",
                "class-1",
                "Thread",
                "thread-A",
            ],
            false,
            &dest,
        )
        .unwrap();
        let e = request_json(
            &record(),
            req,
            &dest,
            Instant::now() + Duration::from_secs(3),
        )
        .await
        .unwrap_err();
        assert_eq!(e.0, "timeout");
        h.join().unwrap();
    }
