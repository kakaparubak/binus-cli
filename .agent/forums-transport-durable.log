            let req = String::from_utf8_lossy(&b[..n]).to_string();
            let _=s.write_all(b"HTTP/1.1 302 Found\r\nLocation: http://127.0.0.1:1/steal\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
            req
        });
