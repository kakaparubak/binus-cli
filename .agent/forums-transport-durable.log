pub struct Envelope<T> {
    schema_version: &'static str,
    status: &'static str,
    data: Vec<T>,
    coverage: Coverage,
    errors: Vec<ApiError>,
    warnings: Vec<String>,
    fetched_at: String,
}
fn now() -> String {
