+            let call = calls.clone();
+            let result = finalize_capture(
+                async move { expected },
+                move || {
+                    call.fetch_add(1, Ordering::SeqCst);
+                    async { Ok(()) }
+                },
+                std::future::pending(),
+            )
+            .await;
+            assert_eq!(result, expected);
+        }
+        let call = calls.clone();
+        let result = finalize_capture(
