struct Handle(HANDLE);
impl Handle {
    fn valid(&self) -> bool {
        !self.0.is_null()
    }
}
impl Drop for Handle {
    fn drop(&mut self) {
        if self.valid() {
            unsafe {
                CloseHandle(self.0);
            }
        }
    }
}

pub(crate) struct Browser {
    process: Handle,
    job: Handle,
    profile: Option<TempDir>,
    terminated: bool,
}

impl Browser {
    pub(crate) fn spawn(
        executable: PathBuf,
        args: &[String],
        profile: TempDir,
    ) -> Result<Self, &'static str> {
