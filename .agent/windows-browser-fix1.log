+        unrelated.0.wait().unwrap();
+
+        let fixture2 = tempfile::tempdir().unwrap();
+        let browser = spawn_tree(fixture2.path());
+        let root: u32 = std::fs::read_to_string(fixture2.path().join("root.pid"))
+            .unwrap()
