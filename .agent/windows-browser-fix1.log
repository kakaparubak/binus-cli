+        let profile_path = browser.profile.as_ref().unwrap().path().to_path_buf();
+        drop(browser);
+        assert_exited(root);
+        assert_exited(descendant);
+        assert!(
+            !profile_path.exists(),
+            "Drop teardown must remove the confirmed tree profile"
+        );
     }
 }
