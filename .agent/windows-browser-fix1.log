+            let result = capture_operation(async move { expected }, std::future::pending()).await;
+            let call = calls.clone();
+            let result = finalize_capture(result, move || {
+                call.fetch_add(1, Ordering::SeqCst);
+                async { Ok(()) }
+            })
+            .await;
+            assert_eq!(result, expected);
+        }
