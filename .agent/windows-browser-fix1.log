s=s[:a]+r'''#[cfg(test)]
mod tests {
    use super::*;
    use std::{process::Command, sync::Mutex};

    static ENV_LOCK: Mutex<()> = Mutex::new(());

    fn fixture_path() -> PathBuf {
        PathBuf::from(std::env::var_os(\"BINUS_SUPERVISOR_TEST_FIXTURE\").unwrap())
    }

    // The subprocess reports both process IDs only after the descendant exists.
    #[test]
    fn helper_process_waits() {
        let Some(parent) = std::env::var(\"BINUS_SUPERVISOR_TEST_PARENT_PID\")
            .ok().and_then(|v| v.parse::<u32>().ok()) else { return };
        if parent == std::process::id() { return; }

        let fixture = fixture_path();
        let level = std::env::var(\"BINUS_SUPERVISOR_TEST_LEVEL\").unwrap_or_default();
        if level.is_empty() {
            let child = Command::new(std::env::current_exe().unwrap())
                .args([\"--exact\", \"browser::native::tests::helper_process_waits\", \"--nocapture\"])
                .env(\"BINUS_SUPERVISOR_TEST_LEVEL\", \"descendant\")
                .spawn().unwrap();
            std::fs::write(fixture.join(\"root.pid\"), std::process::id().to_string()).unwrap();
            drop(child);
        } else if level == \"descendant\" {
            std::fs::write(fixture.join(\"descendant.pid\"), std::process::id().to_string()).unwrap();
        }
        loop { std::thread::park_timeout(Duration::from_secs(1)); }
    }

    fn wait_for_tree(fixture: &std::path::Path) -> (u32, u32) {
        let deadline = Instant::now() + Duration::from_secs(10);
        loop {
            if let (Ok(root), Ok(descendant)) = (
                std::fs::read_to_string(fixture.join(\"root.pid\")),
                std::fs::read_to_string(fixture.join(\"descendant.pid\")),
            ) {
                return (root.parse().unwrap(), descendant.parse().unwrap());
            }
            assert"'!(Instant::now() < deadline, "helper tree readiness deadline elapsed");
            std::thread::park_timeout(Duration::from_millis(10));
        }
    }

    fn assert_member(job: HANDLE, pid: u32) {
        let process = Handle(unsafe { OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, 0, pid) });
        assert!(process.valid(), "reported helper process could not be opened");
        let mut member = 0;
        assert_ne!(unsafe { IsProcessInJob(process.0, job, &mut member) }, 0);
        assert_ne!(member, 0, "reported descendant was outside the owned job");
    }

    fn assert_exited(pid: u32) {
        let process = Handle(unsafe { OpenProcess(0x0010_0000, 0, pid) });
        assert!(process.valid(), "helper process handle could not be opened");
        let deadline = Instant::now() + Duration::from_secs(5);
        loop {
            if unsafe { WaitForSingleObject(process.0, 0) } == WAIT_OBJECT_0 { return; }
            assert!(Instant::now() < deadline, "owned helper process remained alive");
            std::thread::park_timeout(Duration::from_millis(10));
        }
    }

    fn spawn_tree(fixture: &std::path::Path) -> Browser {
        let executable = std::env::current_exe().unwrap();
        let args = ["--exact", "browser::native::tests::helper_process_waits", "--nocapture"]
            .map(str::to_owned);
        let profile = tempfile::tempdir().unwrap();
        unsafe {
            std::env::set_var("BINUS_SUPERVISOR_TEST_PARENT_PID", std::process::id().to_string());
            std::env::set_var("BINUS_SUPERVISOR_TEST_FIXTURE", fixture);
        }
        let browser = Browser::spawn(executable, &args, profile).unwrap();
        let (root, descendant) = wait_for_tree(fixture);
        assert_member(browser.job.0, root);
        assert_member(browser.job.0, descendant);
        unsafe {
            std::env::remove_var("BINUS_SUPERVISOR_TEST_PARENT_PID");
            std::env::remove_var("BINUS_SUPERVISOR_TEST_FIXTURE");
        }
        browser
    }

    #[test]
    fn job_shutdown_reaps_confirmed_tree_and_drop_cleans_up() {
        let _lock = ENV_LOCK.lock().unwrap();
        let fixture = tempfile::tempdir().unwrap();
        let mut browser = spawn_tree(fixture.path());
        let root: u32 = std::fs::read_to_string(fixture.path().join("root.pid")).unwrap().parse().unwrap();
        let descendant: u32 = std::fs::read_to_string(fixture.path().join("descendant.pid")).unwrap().parse().unwrap();
        let profile_path = browser.profile.as_ref().unwrap().path().to_path_buf();

        let mut unrelated = Command::new(std::env::current_exe().unwrap())
            .args(["--exact", "browser::native::tests::helper_process_waits", "--nocapture"])
            .env("BINUS_SUPERVISOR_TEST_PARENT_PID", std::process::id().to_string())
            .env("BINUS_SUPERVISOR_TEST_FIXTURE", fixture.path())
            .env("BINUS_SUPERVISOR_TEST_LEVEL", "unrelated")
            .stdout(std::process::Stdio::null()).stderr(std::process::Stdio::null())
            .spawn().unwrap();
        assert!(browser.cleanup().is_ok());
        assert_exited(root);
        assert_exited(descendant);
        assert!(!profile_path.exists(), "confirmed teardown must remove the profile");
        assert!(unrelated.try_wait().unwrap().is_none());
        unrelated.kill().unwrap();
        unrelated.wait().unwrap();

        let fixture2 = tempfile::tempdir().unwrap();
        let browser = spawn_tree(fixture2.path());
        let root: u32 = std::fs::read_to_string(fixture2.path().join("root.pid")).unwrap().parse().unwrap();
        let descendant: u32 = std::fs::read_to_string(fixture2.path().join("descendant.pid")).unwrap().parse().unwrap();
        let profile_path = browser.profile.as_ref().unwrap().path().to_path_buf();
        drop(browser);
        assert_exited(root);
        assert_exited(descendant);
        assert!(!profile_path.exists(), "Drop teardown must remove the confirmed tree profile");
    }
}
