#[derive(Serialize)]
pub struct Status {
    pub status: &'static str,
    pub stored: bool,
    pub live_verified: bool,
    pub blocker: Option<&'static str>,
}

pub fn sanitized_status(
    stored: bool,
    live_verified: bool,
    blocker: Option<&'static str>,
) -> Status {
    Status {
        status: if live_verified {
            "live_verified"
        } else if stored {
            "stored_unverified"
        } else {
            "not_logged_in"
        },
        stored,
        live_verified,
        blocker,
    }
