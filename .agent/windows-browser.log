+++ b/spikes/001-auth/src/browser.rs
@@ -0,0 +1,138 @@
+#[cfg(any(windows, test))]
+use std::path::{Path, PathBuf};
+
+/// Encode one argument using the Windows CRT command-line parsing rules.
+#[cfg(any(windows, test))]
+pub(crate) fn quote_windows_argument(value: &str) -> String {
+    if !value.is_empty() && !value.chars().any(|c| c.is_whitespace() || c == '"') {
+        return value.to_owned();
+    }
+    let mut out = String::from("\"");
+    let mut slashes = 0usize;
+    for ch in value.chars() {
+        match ch {
+            '\\' => slashes += 1,
+            '"' => {
+                out.extend(std::iter::repeat_n('\\', slashes * 2 + 1));
+                out.push('"');
+                slashes = 0;
+            }
+            _ => {
+                out.extend(std::iter::repeat_n('\\', slashes));
+                slashes = 0;
+                out.push(ch);
+            }
+        }
+    }
+    out.extend(std::iter::repeat_n('\\', slashes * 2));
+    out.push('"');
+    out
+}
+
+#[cfg(any(windows, test))]
+pub(crate) fn select_executable(
+    override_path: Option<&Path>,
+    candidates: &[PathBuf],
+) -> Option<PathBuf> {
+    if let Some(path) = override_path {
+        return (path.is_absolute() && path.is_file()).then(|| path.to_owned());
+    }
+    candidates
+        .iter()
+        .find(|path| path.is_absolute() && path.is_file())
+        .cloned()
+}
+
+#[cfg(any(windows, test))]
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum LaunchState {
+    Suspended,
+    Assigned,
+    Running,
+}
+
+#[cfg(any(windows, test))]
+pub(crate) fn assigned_to_job(state: LaunchState) -> Option<LaunchState> {
+    (state == LaunchState::Suspended).then_some(LaunchState::Assigned)
+}
+
+#[cfg(any(windows, test))]
+pub(crate) fn resumed(state: LaunchState) -> Option<LaunchState> {
+    (state == LaunchState::Assigned).then_some(LaunchState::Running)
+}
+
+#[cfg(any(windows, test))]
+pub(crate) const fn profile_cleanup_allowed(confirmed: bool) -> bool {
+    confirmed
+}
+
+#[cfg(windows)]
+mod native;
+
+#[cfg(windows)]
+pub(crate) use native::Browser;
+
+#[cfg(windows)]
+pub(crate) fn resolve_executable() -> Result<PathBuf, &'static str> {
+    native::resolve_executable()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::fs;
+
+    #[test]
+    fn windows_quoting_handles_spaces_unicode_quotes_and_trailing_slashes() {
+        assert_eq!(
+            quote_windows_argument(r#"C:\Program Files\Edge\msedge.exe"#),
+            r#""C:\Program Files\Edge\msedge.exe""#
+        );
+        assert_eq!(
+            quote_windows_argument("路径 with spaces\\"),
+            "\"路径 with spaces\\\\\""
+        );
+        assert_eq!(quote_windows_argument("a\\\"b"), "\"a\\\\\\\"b\"");
+        assert_eq!(quote_windows_argument("plain"), "plain");
+    }
+
+    #[test]
+    fn explicit_override_is_single_path_and_never_falls_back() {
+        let dir = tempfile::tempdir().unwrap();
+        let explicit = dir.path().join("browser path.exe");
+        let candidate = dir.path().join("installed.exe");
+        fs::write(&candidate, b"candidate").unwrap();
+        assert_eq!(
+            select_executable(Some(&explicit), std::slice::from_ref(&candidate)),
+            None
+        );
+        fs::write(&explicit, b"explicit").unwrap();
+        assert_eq!(
+            select_executable(Some(&explicit), &[candidate]),
+            Some(explicit)
+        );
+    }
+
+    #[test]
+    fn candidates_keep_declared_edge_before_chrome_order() {
+        let dir = tempfile::tempdir().unwrap();
+        let edge = dir.path().join("edge.exe");
+        let chrome = dir.path().join("chrome.exe");
+        fs::write(&edge, b"edge").unwrap();
+        fs::write(&chrome, b"chrome").unwrap();
+        assert_eq!(select_executable(None, &[edge.clone(), chrome]), Some(edge));
+    }
+
+    #[test]
+    fn launch_and_cleanup_policy_is_used_by_native_supervisor() {
+        assert_eq!(
+            assigned_to_job(LaunchState::Suspended),
+            Some(LaunchState::Assigned)
+        );
+        assert_eq!(resumed(LaunchState::Assigned), Some(LaunchState::Running));
+        assert_eq!(resumed(LaunchState::Suspended), None);
+        assert_eq!(assigned_to_job(LaunchState::Running), None);
+        assert!(!profile_cleanup_allowed(false));
+        assert!(profile_cleanup_allowed(true));
+    }
+}
diff --git a/spikes/001-auth/src/browser/native.rs b/spikes/001-auth/src/browser/native.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ed4f279f796915dbb34fd4af12ab7387e4e5c68d
--- /dev/null
+++ b/spikes/001-auth/src/browser/native.rs
@@ -0,0 +1,335 @@
+use super::{
+    LaunchState, assigned_to_job, profile_cleanup_allowed, quote_windows_argument, resumed,
+    select_executable,
+};
+use std::{
+    ffi::OsStr,
+    os::windows::ffi::OsStrExt,
+    path::PathBuf,
+    ptr::{null, null_mut},
+    time::{Duration, Instant},
+};
+use tempfile::TempDir;
+use windows_sys::Win32::{
+    Foundation::{CloseHandle, HANDLE, WAIT_OBJECT_0, WAIT_TIMEOUT},
+    System::Com::CoTaskMemFree,
+    System::{
+        JobObjects::{
+            AssignProcessToJobObject, CreateJobObjectW, JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE,
+            JOBOBJECT_BASIC_ACCOUNTING_INFORMATION, JOBOBJECT_EXTENDED_LIMIT_INFORMATION,
+            JobObjectBasicAccountingInformation, JobObjectExtendedLimitInformation,
+            QueryInformationJobObject, SetInformationJobObject, TerminateJobObject,
+        },
+        Threading::{
+            CREATE_SUSPENDED, CreateProcessW, PROCESS_INFORMATION, ResumeThread, STARTUPINFOW,
+            TerminateProcess, WaitForSingleObject,
+        },
+    },
+    UI::Shell::{
+        FOLDERID_LocalAppData, FOLDERID_ProgramFiles, FOLDERID_ProgramFilesX86,
+        SHGetKnownFolderPath,
+    },
+};
+
+struct Handle(HANDLE);
+impl Handle {
+    fn valid(&self) -> bool {
+        !self.0.is_null()
+    }
+}
+impl Drop for Handle {
+    fn drop(&mut self) {
+        if self.valid() {
+            unsafe {
+                CloseHandle(self.0);
+            }
+        }
+    }
+}
+
+pub(crate) struct Browser {
+    process: Handle,
+    job: Handle,
+    profile: Option<TempDir>,
+    terminated: bool,
+}
+
+impl Browser {
+    pub(crate) fn spawn(
+        executable: PathBuf,
+        args: &[String],
+        profile: TempDir,
+    ) -> Result<Self, &'static str> {
+        let job = Handle(unsafe { CreateJobObjectW(null(), null()) });
+        if !job.valid() {
+            return Err("browser_launch_failed");
+        }
+        let mut limits = JOBOBJECT_EXTENDED_LIMIT_INFORMATION::default();
+        limits.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
+        if unsafe {
+            SetInformationJobObject(
+                job.0,
+                JobObjectExtendedLimitInformation,
+                &limits as *const _ as *const _,
+                std::mem::size_of_val(&limits) as u32,
+            )
+        } == 0
+        {
+            return Err("browser_launch_failed");
+        }
+
+        let app = wide(executable.as_os_str());
+        let mut command = quote_windows_argument(&executable.to_string_lossy());
+        for arg in args {
+            command.push(' ');
+            command.push_str(&quote_windows_argument(arg));
+        }
+        let mut command: Vec<u16> = command.encode_utf16().chain(std::iter::once(0)).collect();
+        let mut startup = STARTUPINFOW::default();
+        startup.cb = std::mem::size_of::<STARTUPINFOW>() as u32;
+        let mut info = PROCESS_INFORMATION::default();
+        let created = unsafe {
+            CreateProcessW(
+                app.as_ptr(),
+                command.as_mut_ptr(),
+                null(),
+                null(),
+                0,
+                CREATE_SUSPENDED,
+                null(),
+                null(),
+                &startup,
+                &mut info,
+            )
+        };
+        if created == 0 {
+            return Err("browser_launch_failed");
+        }
+        let process = Handle(info.hProcess);
+        let thread = Handle(info.hThread);
+        if unsafe { AssignProcessToJobObject(job.0, process.0) } == 0 {
+            if !terminate_child(process.0) {
+                std::mem::forget(process);
+                std::mem::forget(thread);
+                std::mem::forget(profile);
+                return Err("browser_cleanup_failed");
+            }
+            return Err("browser_launch_failed");
+        }
+        let launch_state =
+            assigned_to_job(LaunchState::Suspended).ok_or("browser_launch_failed")?;
+        if resumed(launch_state) != Some(LaunchState::Running) {
+            terminate_child(process.0);
+            return Err("browser_launch_failed");
+        }
+        if unsafe { ResumeThread(thread.0) } == u32::MAX {
+            unsafe {
+                TerminateJobObject(job.0, 1);
+            }
+            if !terminate_child(process.0) {
+                std::mem::forget(process);
+                std::mem::forget(thread);
+                std::mem::forget(job);
+                std::mem::forget(profile);
+                return Err("browser_cleanup_failed");
+            }
+            return Err("browser_launch_failed");
+        }
+        drop(thread);
+        Ok(Self {
+            process,
+            job,
+            profile: Some(profile),
+            terminated: false,
+        })
+    }
+
+    pub(crate) fn try_wait(&mut self) -> Result<Option<()>, &'static str> {
+        match unsafe { WaitForSingleObject(self.process.0, 0) } {
+            WAIT_OBJECT_0 => Ok(Some(())),
+            WAIT_TIMEOUT => Ok(None),
+            _ => Err("browser_launch_failed"),
+        }
+    }
+
+    pub(crate) fn cleanup(&mut self) -> Result<(), &'static str> {
+        if self.terminated {
+            return Ok(());
+        }
+        let active = active_processes(self.job.0).ok_or("browser_cleanup_failed")?;
+        if active != 0 && unsafe { TerminateJobObject(self.job.0, 1) } == 0 {
+            return Err("browser_cleanup_failed");
+        }
+        let deadline = Instant::now() + Duration::from_secs(2);
+        let root_done = unsafe { WaitForSingleObject(self.process.0, 2_000) } == WAIT_OBJECT_0;
+        loop {
+            let termination_confirmed = root_done && active_processes(self.job.0) == Some(0);
+            if profile_cleanup_allowed(termination_confirmed) {
+                self.terminated = true;
+                self.profile.take();
+                return Ok(());
+            }
+            if Instant::now() >= deadline {
+                return Err("browser_cleanup_failed");
+            }
+            std::thread::sleep(Duration::from_millis(20));
+        }
+    }
+}
+
+fn active_processes(job: HANDLE) -> Option<u32> {
+    let mut accounting = JOBOBJECT_BASIC_ACCOUNTING_INFORMATION::default();
+    (unsafe {
+        QueryInformationJobObject(
+            job,
+            JobObjectBasicAccountingInformation,
+            &mut accounting as *mut _ as *mut _,
+            std::mem::size_of_val(&accounting) as u32,
+            null_mut(),
+        )
+    } != 0)
+        .then_some(accounting.ActiveProcesses)
+}
+
+impl Drop for Browser {
+    fn drop(&mut self) {
+        if !self.terminated && self.cleanup().is_err() {
+            // Keep the isolated profile if tree termination could not be confirmed.
+            if let Some(profile) = self.profile.take() {
+                std::mem::forget(profile);
+            }
+        }
+    }
+}
+
+fn terminate_child(process: HANDLE) -> bool {
+    unsafe {
+        TerminateProcess(process, 1);
+    }
+    unsafe { WaitForSingleObject(process, 2_000) == WAIT_OBJECT_0 }
+}
+
+fn wide(value: &OsStr) -> Vec<u16> {
+    value.encode_wide().chain(std::iter::once(0)).collect()
+}
+
+fn known_folder(id: &windows_sys::core::GUID) -> Option<PathBuf> {
+    let mut ptr = null_mut();
+    if unsafe { SHGetKnownFolderPath(id, 0, null_mut(), &mut ptr) } < 0 || ptr.is_null() {
+        return None;
+    }
+    let mut len = 0;
+    unsafe {
+        while *ptr.add(len) != 0 {
+            len += 1;
+        }
+    }
+    let value = unsafe { String::from_utf16(std::slice::from_raw_parts(ptr, len)).ok() };
+    unsafe {
+        CoTaskMemFree(ptr.cast());
+    }
+    value.map(PathBuf::from)
+}
+
+pub(crate) fn resolve_executable() -> Result<PathBuf, &'static str> {
+    let explicit = std::env::var_os("BINUS_CHROMIUM");
+    if let Some(value) = explicit {
+        let path = PathBuf::from(value);
+        return select_executable(Some(&path), &[]).ok_or("browser_launch_failed");
+    }
+    let roots = [
+        known_folder(&FOLDERID_ProgramFilesX86),
+        known_folder(&FOLDERID_ProgramFiles),
+        known_folder(&FOLDERID_LocalAppData),
+    ];
+    let mut candidates = Vec::new();
+    for root in roots.iter().flatten() {
+        candidates.push(root.join("Microsoft\\Edge\\Application\\msedge.exe"));
+    }
+    for root in roots.iter().flatten() {
+        candidates.push(root.join("Google\\Chrome\\Application\\chrome.exe"));
+    }
+    select_executable(None, &candidates).ok_or("browser_launch_failed")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::{process::Command, sync::Mutex};
+
+    static ENV_LOCK: Mutex<()> = Mutex::new(());
+
+    // This test is also used as an isolated, inert child process by the lifecycle test.
+    #[test]
+    fn helper_process_waits() {
+        if std::env::var("BINUS_SUPERVISOR_TEST_PARENT_PID")
+            .ok()
+            .and_then(|pid| pid.parse::<u32>().ok())
+            .is_some_and(|pid| pid != std::process::id())
+        {
+            if std::env::var_os("BINUS_SUPERVISOR_TEST_LEVEL").is_none() {
+                let _ = Command::new(std::env::current_exe().unwrap())
+                    .args([
+                        "--exact",
+                        "browser::native::tests::helper_process_waits",
+                        "--nocapture",
+                    ])
+                    .env("BINUS_SUPERVISOR_TEST_LEVEL", "descendant")
+                    .spawn()
+                    .unwrap();
+            }
+            loop {
+                std::thread::sleep(Duration::from_secs(1));
+            }
+        }
+    }
+
+    #[test]
+    fn job_shutdown_reaps_only_its_helper_tree_and_drop_cleans_up() {
+        let _lock = ENV_LOCK.lock().unwrap();
+        let parent_pid = std::process::id().to_string();
+        unsafe {
+            std::env::set_var("BINUS_SUPERVISOR_TEST_PARENT_PID", &parent_pid);
+        }
+        let executable = std::env::current_exe().unwrap();
+        let args = [
+            "--exact".to_owned(),
+            "browser::native::tests::helper_process_waits".to_owned(),
+            "--nocapture".to_owned(),
+        ];
+        let profile = tempfile::tempdir().unwrap();
+        let mut browser = Browser::spawn(executable.clone(), &args, profile).unwrap();
+        std::thread::sleep(Duration::from_millis(150));
+
+        let mut unrelated = Command::new(executable)
+            .args([
+                "--exact",
+                "browser::native::tests::helper_process_waits",
+                "--nocapture",
+            ])
+            .env("BINUS_SUPERVISOR_TEST_PARENT_PID", &parent_pid)
+            .env("BINUS_SUPERVISOR_TEST_LEVEL", "unrelated")
+            .stdout(std::process::Stdio::null())
+            .stderr(std::process::Stdio::null())
+            .spawn()
+            .unwrap();
+        std::thread::sleep(Duration::from_millis(100));
+        assert!(browser.cleanup().is_ok());
+        assert!(unrelated.try_wait().unwrap().is_none());
+        unrelated.kill().unwrap();
+        unrelated.wait().unwrap();
+        unsafe {
+            std::env::remove_var("BINUS_SUPERVISOR_TEST_PARENT_PID");
+        }
+
+        // The Drop path must perform the same bounded job teardown.
+        let profile = tempfile::tempdir().unwrap();
+        unsafe {
+            std::env::set_var("BINUS_SUPERVISOR_TEST_PARENT_PID", &parent_pid);
+        }
+        drop(Browser::spawn(std::env::current_exe().unwrap(), &args, profile).unwrap());
+        unsafe {
+            std::env::remove_var("BINUS_SUPERVISOR_TEST_PARENT_PID");
+        }
+    }
+}
