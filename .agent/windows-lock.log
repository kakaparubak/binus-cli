+        let worker_name = name.clone();
+        std::thread::spawn(move || {
+            let guard = acquire_named(&worker_name).expect("worker acquisition");
+            std::mem::forget(guard);
+        })
+        .join()
+        .expect("worker exit");
+        assert_eq!(acquire_named(&name).err(), Some("storage_error"));
+    }
+
