index 0000000000000000000000000000000000000000..4b7e92b203fd3108854bd5cede7b3f1b07b61787
--- /dev/null
+++ b/spikes/001-auth/src/windows_lock/native.rs
@@ -0,0 +1,136 @@
+use super::{accepts_descriptor, wait_decision, AcePolicy, DescriptorPolicy, WaitDecision};
+use std::{ffi::c_void, marker::PhantomData, rc::Rc};
+use windows_sys::Win32::{
+    Foundation::{CloseHandle, GetLastError, LocalFree, HANDLE, ERROR_NO_TOKEN},
+    Security::{
+        AddAccessAllowedAce, EqualSid, GetAce, GetAclInformation, GetSecurityDescriptorControl,
+        GetSecurityDescriptorDacl, GetSecurityDescriptorOwner, GetTokenInformation,
+        InitializeAcl, IsValidSid, SetSecurityDescriptorDacl, SetSecurityDescriptorOwner,
+        SetSecurityDescriptorControl,
+        ACL, ACL_SIZE_INFORMATION, ACL_REVISION, ACCESS_ALLOWED_ACE, ACE_HEADER,
+        DACL_SECURITY_INFORMATION, OBJECT_SECURITY_INFORMATION,
+        OWNER_SECURITY_INFORMATION, PSECURITY_DESCRIPTOR, PSID, SECURITY_ATTRIBUTES,
+        SECURITY_DESCRIPTOR, SECURITY_DESCRIPTOR_CONTROL, SE_DACL_PRESENT,
+        SE_DACL_PROTECTED, TOKEN_QUERY, TOKEN_USER, TokenUser,
+    },
+    Security::Authorization::{GetSecurityInfo, SE_KERNEL_OBJECT},
+    System::Threading::{CreateMutexExW, GetCurrentProcess, GetCurrentThread, OpenThreadToken, ReleaseMutex, WaitForSingleObject, MUTEX_ALL_ACCESS, MUTEX_MODIFY_STATE},
+};
+
+const SYNCHRONIZE: u32 = 0x0010_0000;
+const HANDLE_ACCESS: u32 = SYNCHRONIZE | MUTEX_MODIFY_STATE | 0x0002_0000; // READ_CONTROL
+const WAIT_MS: u32 = 10_000;
+
+struct Handle(HANDLE);
+impl Drop for Handle { fn drop(&mut self) { if !self.0.is_null() { unsafe { CloseHandle(self.0); } } } }
+struct Local(*mut c_void);
+impl Drop for Local { fn drop(&mut self) { if !self.0.is_null() { unsafe { LocalFree(self.0); } } } }
+
+/// A mutex ownership guard is deliberately neither Send nor Sync: Windows mutex ownership
+/// belongs to the thread that acquired it.
+pub struct MutexGuard { handle: Handle, _thread_bound: PhantomData<Rc<()>> }
+impl Drop for MutexGuard { fn drop(&mut self) { unsafe { ReleaseMutex(self.handle.0); } } }
+
+struct Token(Handle);
+fn effective_token() -> Result<Token, &'static str> {
+    let mut h = std::ptr::null_mut();
+    let ok = unsafe { OpenThreadToken(GetCurrentThread(), TOKEN_QUERY, 1, &mut h) };
+    if ok != 0 { return Ok(Token(Handle(h))); }
+    if unsafe { GetLastError() } != ERROR_NO_TOKEN { return Err("storage_error"); }
+    let mut h = std::ptr::null_mut();
+    let ok = unsafe { windows_sys::Win32::System::Threading::OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &mut h) };
+    if ok == 0 { Err("storage_error") } else { Ok(Token(Handle(h))) }
+}
+
+unsafe fn user_sid(token: HANDLE) -> Result<(Vec<u64>, PSID), &'static str> {
+    let mut needed = 0;
+    unsafe { GetTokenInformation(token, TokenUser, std::ptr::null_mut(), 0, &mut needed); }
+    if needed < std::mem::size_of::<TOKEN_USER>() as u32 || needed > 1024 * 1024 { return Err("storage_error"); }
+    // Vec<u64> supplies alignment required for TOKEN_USER and its embedded SID pointer.
+    let mut backing = vec![0u64; (needed as usize).div_ceil(8)];
+    if unsafe { GetTokenInformation(token, TokenUser, backing.as_mut_ptr().cast(), needed, &mut needed) } == 0 { return Err("storage_error"); }
+    let tu = unsafe { &*backing.as_ptr().cast::<TOKEN_USER>() };
+    if tu.User.Sid.is_null() || unsafe { IsValidSid(tu.User.Sid) } == 0 { return Err("storage_error"); }
+    let length = unsafe { windows_sys::Win32::Security::GetLengthSid(tu.User.Sid) } as usize;
+    if length < 8 || length > 68 { return Err("storage_error"); }
+    Ok((backing, tu.User.Sid))
+}
+
+unsafe fn descriptor(sid: PSID) -> Result<(Vec<u64>, SECURITY_DESCRIPTOR), &'static str> {
+    let acl_bytes = 1024usize;
+    let mut acl_storage = vec![0u64; acl_bytes.div_ceil(8)];
+    let acl = acl_storage.as_mut_ptr().cast::<ACL>();
+    let mut sd = SECURITY_DESCRIPTOR::default();
+    if unsafe { InitializeAcl(acl, acl_bytes as u32, ACL_REVISION) } == 0
+        || unsafe { AddAccessAllowedAce(acl, ACL_REVISION, MUTEX_ALL_ACCESS, sid) } == 0
+        || unsafe { windows_sys::Win32::Security::InitializeSecurityDescriptor((&mut sd as *mut SECURITY_DESCRIPTOR).cast(), 1) } == 0
+        || unsafe { SetSecurityDescriptorOwner((&mut sd as *mut SECURITY_DESCRIPTOR).cast(), sid, 0) } == 0
+        || unsafe { SetSecurityDescriptorDacl((&mut sd as *mut SECURITY_DESCRIPTOR).cast(), 1, acl, 0) } == 0
+        || unsafe { SetSecurityDescriptorControl((&mut sd as *mut SECURITY_DESCRIPTOR).cast(), SE_DACL_PROTECTED, SE_DACL_PROTECTED) } == 0
+    { return Err("storage_error"); }
+    // Keep ACL allocation alive through CreateMutexExW; descriptor copied by the kernel.
+    Ok((acl_storage, sd))
+}
+
+unsafe fn inspect(handle: HANDLE, expected_sid: PSID) -> Result<(), &'static str> {
+    let mut owner: PSID = std::ptr::null_mut();
+    let mut dacl: *mut ACL = std::ptr::null_mut();
+    let mut sd: PSECURITY_DESCRIPTOR = std::ptr::null_mut();
+    let info: OBJECT_SECURITY_INFORMATION = OWNER_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION;
+    if unsafe { GetSecurityInfo(handle, SE_KERNEL_OBJECT, info, &mut owner, std::ptr::null_mut(), &mut dacl, std::ptr::null_mut(), &mut sd) } != 0 || sd.is_null() { return Err("storage_error"); }
+    let _sd = Local(sd.cast());
+    let mut control: SECURITY_DESCRIPTOR_CONTROL = 0;
+    let mut revision = 0;
+    let mut owner_out = std::ptr::null_mut();
+    let mut owner_defaulted = 0;
+    let mut present = 0;
+    let mut dacl_out = std::ptr::null_mut();
+    let mut dacl_defaulted = 0;
+    if unsafe { GetSecurityDescriptorControl(sd, &mut control, &mut revision) } == 0
+        || unsafe { GetSecurityDescriptorOwner(sd, &mut owner_out, &mut owner_defaulted) } == 0
+        || unsafe { GetSecurityDescriptorDacl(sd, &mut present, &mut dacl_out, &mut dacl_defaulted) } == 0
+        || owner_out.is_null() || unsafe { IsValidSid(owner_out) } == 0 || unsafe { EqualSid(owner_out, expected_sid) } == 0
+        || control & SE_DACL_PRESENT == 0 || control & SE_DACL_PROTECTED == 0 || present == 0 || dacl_out.is_null()
+    { return Err("storage_error"); }
+    let mut sizes = ACL_SIZE_INFORMATION::default();
+    if unsafe { GetAclInformation(dacl_out, (&mut sizes as *mut ACL_SIZE_INFORMATION).cast(), std::mem::size_of::<ACL_SIZE_INFORMATION>() as u32, 2) } == 0 || sizes.AceCount != 1 { return Err("storage_error"); }
+    let mut ace_ptr: *mut c_void = std::ptr::null_mut();
+    if unsafe { GetAce(dacl_out, 0, &mut ace_ptr) } == 0 || ace_ptr.is_null() { return Err("storage_error"); }
+    let hdr = unsafe { &*ace_ptr.cast::<ACE_HEADER>() };
+    if (hdr.AceSize as usize) < std::mem::size_of::<ACCESS_ALLOWED_ACE>() + 8 || (hdr.AceSize as usize) > sizes.AclBytesInUse as usize { return Err("storage_error"); }
+    let ace = unsafe { &*ace_ptr.cast::<ACCESS_ALLOWED_ACE>() };
+    let sid_ptr = unsafe { ace_ptr.cast::<u8>().add(std::mem::offset_of!(ACCESS_ALLOWED_ACE, SidStart)).cast() };
+    if unsafe { IsValidSid(sid_ptr) } == 0 || unsafe { EqualSid(sid_ptr, expected_sid) } == 0 { return Err("storage_error"); }
+    let sid_len = unsafe { windows_sys::Win32::Security::GetLengthSid(sid_ptr) } as usize;
+    if hdr.AceSize as usize != std::mem::offset_of!(ACCESS_ALLOWED_ACE, SidStart) + sid_len { return Err("storage_error"); }
+    let accepted = accepts_descriptor(&DescriptorPolicy { owner_matches: true, dacl_present: true, dacl_protected: true, null_dacl: false,
+        aces: vec![AcePolicy { allowed: hdr.AceType == 0, explicit: hdr.AceFlags == 0, mask: ace.Mask, sid_matches: true }] }, MUTEX_ALL_ACCESS);
+    if accepted { Ok(()) } else { Err("storage_error") }
+}
+
+pub fn acquire() -> Result<MutexGuard, &'static str> { acquire_named("Global\\BinusAuthSpike.Lock.v1") }
+fn acquire_named(name: &str) -> Result<MutexGuard, &'static str> {
+    let token = effective_token()?;
+    let (_sid_backing, sid) = unsafe { user_sid(token.0.0)? };
+    let (_acl_storage, sd) = unsafe { descriptor(sid)? };
+    let mut attrs = SECURITY_ATTRIBUTES { nLength: std::mem::size_of::<SECURITY_ATTRIBUTES>() as u32, lpSecurityDescriptor: (&sd as *const SECURITY_DESCRIPTOR).cast_mut().cast(), bInheritHandle: 0 };
+    let wide: Vec<u16> = name.encode_utf16().chain(std::iter::once(0)).collect();
+    let h = unsafe { CreateMutexExW(&mut attrs, wide.as_ptr(), 0, HANDLE_ACCESS) };
+    if h.is_null() { return Err("storage_error"); }
+    let handle = Handle(h);
+    unsafe { inspect(handle.0, sid)?; }
+    let result = unsafe { WaitForSingleObject(handle.0, WAIT_MS) };
+    match wait_decision(result) {
+        WaitDecision::Acquired => Ok(MutexGuard { handle, _thread_bound: PhantomData }),
+        WaitDecision::Abandoned => { unsafe { ReleaseMutex(handle.0); } Err("storage_error") },
+        WaitDecision::TimedOut | WaitDecision::Failed => Err("storage_error"),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test] fn native_private_mutex_acquires_and_releases() {
+        let _guard = acquire_named("Global\\BinusAuthSpike.Test.Lock.v1").expect("isolated mutex");
+    }
+}

