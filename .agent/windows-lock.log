+    if hdr.AceSize as usize != sid_offset + sid_len || sid_len != sid_len_from_header {
+        return Err("storage_error");
+    }
+    let accepted = accepts_descriptor(
+        &DescriptorPolicy {
+            owner_matches: true,
+            dacl_present: true,
+            dacl_protected: true,
+            null_dacl: false,
+            aces: vec![AcePolicy {
+                allowed: hdr.AceType == 0,
+                explicit: hdr.AceFlags == 0,
+                mask: ace.Mask,
+                sid_matches: true,
+            }],
+        },
