+/// belongs to the thread that acquired it.
+pub struct MutexGuard {
+    handle: Handle,
+    _thread_bound: PhantomData<Rc<()>>,
+}
+impl Drop for MutexGuard {
+    fn drop(&mut self) {
+        unsafe {
+            ReleaseMutex(self.handle.0);
+        }
+    }
+}
+
