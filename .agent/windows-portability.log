   413	fn recognized_temp_name(name: &str) -> bool {
   414	    [
   415	        "credentials.tmp-",
   416	        "credentials.captured.tmp-",
   417	        "credentials.json.tmp-",
   418	        "credentials.captured.json.tmp-",
   419	    ]
   420	    .iter()
   421	    .any(|prefix| {
   422	        name.strip_prefix(prefix)
   423	            .is_some_and(|suffix| !suffix.is_empty() && suffix.bytes().all(|b| b.is_ascii_digit()))
   424	    })
   425	}
