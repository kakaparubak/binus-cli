   463	async fn capture_with_signals(timeout: Duration) -> Result<CredentialRecord, &'static str> {
   464	    let future = capture(timeout);
   465	    tokio::pin!(future);
   466	    let mut terminate = tokio::signal::unix::signal(tokio::signal::unix::SignalKind::terminate())
   467	        .map_err(|_| "signal_setup_failed")?;
   468	    tokio::select! {
   469	        result = &mut future => result,
   470	        _ = tokio::signal::ctrl_c() => Err("capture_cancelled"),
   471	        _ = terminate.recv() => Err("capture_cancelled"),
   472	    }
   473	}
