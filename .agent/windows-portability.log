   404	pub fn load_preferred_record(primary: &Path) -> Result<(CredentialRecord, bool), &'static str> {
   405	    let candidate = primary.with_file_name("credentials.captured.json");
   406	    match load_record(&candidate) {
   407	        Ok(record) => Ok((record, true)),
   408	        Err("not_logged_in") => load_record(primary).map(|record| (record, false)),
   409	        Err(error) => Err(error),
   410	    }
   411	}
