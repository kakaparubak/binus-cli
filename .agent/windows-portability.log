   456	struct Cdp {
   457	    ws: tokio_tungstenite::WebSocketStream<
   458	        tokio_tungstenite::MaybeTlsStream<tokio::net::TcpStream>,
   459	    >,
   460	    id: u64,
   461	    session: Option<String>,
   462	    guard_enable: HashMap<u64, String>,
   463	    guard_remaining: HashMap<String, u8>,
   464	    pending_acks: HashMap<u64, (Option<String>, &'static str)>,
   465	    paused_count: u64,
   466	    blocked_count: u64,
   467	}
   468	impl Cdp {
   469	    async fn send(&mut self, method: &str, params: Value) -> Result<Value, &'static str> {
   470	        self.id += 1;
   471	        let id = self.id;
   472	        let mut command = json!({"id":id,"method":method,"params":params});
   473	        let expected_session = self.session.clone();
   474	        if let Some(session) = &self.session {
   475	            command["sessionId"] = json!(session);
   476	        }
   477	        self.ws
   478	            .send(Message::Text(command.to_string().into()))
   479	            .await
   480	            .map_err(|_| "browser_protocol_error")?;
   481	        loop {
   482	            let message = self
   483	                .ws
   484	                .next()
   485	                .await
   486	                .ok_or("browser_protocol_error")?
   487	                .map_err(|_| "browser_protocol_error")?;
   488	            if let Message::Text(text) = message {
   489	                let value: Value =
   490	                    serde_json::from_str(&text).map_err(|_| "browser_protocol_error")?;
   491	                if let Some(session) = value["id"]
   492	                    .as_u64()
   493	                    .and_then(|event_id| self.guard_enable.remove(&event_id))
   494	                {
   495	                    if value.get("error").is_some()
   496	                        || value.get("sessionId").and_then(Value::as_str) != Some(session.as_str())
   497	                    {
   498	                        return Err("browser_protocol_error");
   499	                    }
   500	                    let remaining = self
   501	                        .guard_remaining
   502	                        .get_mut(&session)
   503	                        .ok_or("browser_protocol_error")?;
   504	                    *remaining -= 1;
   505	                    if *remaining == 0 {
   506	                        self.guard_remaining.remove(&session);
   507	                        self.id += 1;
   508	                        if self.pending_acks.len() >= 256 {
   509	                            return Err("browser_protocol_error");
   510	                        }
   511	                        let resume = json!({"id":self.id,"method":"Runtime.runIfWaitingForDebugger","params":{},"sessionId":session});
   512	                        self.pending_acks
   513	                            .insert(self.id, (Some(session.clone()), "resume"));
   514	                        self.ws
   515	                            .send(Message::Text(resume.to_string().into()))
   516	                            .await
   517	                            .map_err(|_| "browser_protocol_error")?;
   518	                    }
   519	                    continue;
   520	                }
   521	                if let Some(ack_id) = value["id"]
   522	                    .as_u64()
   523	                    .filter(|ack_id| self.pending_acks.contains_key(ack_id))
   524	                {
   525	                    let (session, kind) = self
   526	                        .pending_acks
   527	                        .remove(&ack_id)
   528	                        .ok_or("browser_protocol_error")?;
   529	                    if value.get("sessionId").and_then(Value::as_str) != session.as_deref() {
   530	                        return Err("browser_protocol_error");
   531	                    }
   532	                    if value.get("error").is_some() && !benign_ack_error(kind, &value["error"]) {
   533	                        return Err("browser_protocol_error");
   534	                    }
   535	                    continue;
   536	                }
   537	                if value["id"].as_u64() == Some(id) {
   538	                    if value.get("sessionId").and_then(Value::as_str) != expected_session.as_deref()
   539	                    {
   540	                        return Err("browser_protocol_error");
   541	                    }
   542	                    return if let Some(error) = value.get("error") {
   543	                        if method == "Runtime.evaluate" && recognized_navigation_error(error) {
   544	                            Err("evaluation_context_changed")
   545	                        } else {
   546	                            Err("browser_protocol_error")
   547	                        }
   548	                    } else {
   549	                        Ok(value["result"].clone())
   550	                    };
   551	                }
   552	                if value["method"] == "Fetch.requestPaused" {
   553	                    self.paused_count += 1;
   554	                    let request = &value["params"]["request"];
   555	                    let url = request["url"].as_str().unwrap_or("");
   556	                    let method = request["method"].as_str().unwrap_or("");
   557	                    let continue_request = azure_request_allowed(method, url);
   558	                    if !continue_request {
   559	                        self.blocked_count += 1;
   560	                    }
   561	                    let cmd = if continue_request {
   562	                        "Fetch.continueRequest"
   563	                    } else {
   564	                        "Fetch.failRequest"
   565	                    };
   566	                    let params = if continue_request {
   567	                        json!({"requestId":value["params"]["requestId"]})
   568	                    } else {
   569	                        json!({"requestId":value["params"]["requestId"],"errorReason":"BlockedByClient"})
   570	                    };
   571	                    self.id += 1;
   572	                    let mut response = json!({"id":self.id,"method":cmd,"params":params});
   573	                    let session = value["sessionId"].as_str().map(str::to_owned);
   574	                    if let Some(session) = &session {
   575	                        response["sessionId"] = json!(session);
   576	                    }
   577	                    if self.pending_acks.len() >= 256 {
   578	                        return Err("browser_protocol_error");
   579	                    }
   580	                    self.pending_acks.insert(self.id, (session, "fetch"));
   581	                    self.ws
   582	                        .send(Message::Text(response.to_string().into()))
   583	                        .await
   584	                        .map_err(|_| "browser_protocol_error")?;
   585	                } else if value["method"] == "Target.attachedToTarget"
   586	                    && let Some(session) = value["params"]["sessionId"].as_str()
   587	                {
   588	                    if self.guard_enable.len() + self.guard_remaining.len() >= 256 {
   589	                        return Err("browser_protocol_error");
   590	                    }
   591	                    self.guard_remaining.insert(session.to_owned(), 2);
   592	                    for (method, params) in [
   593	                        ("Fetch.enable", fetch_params()),
   594	                        ("Target.setAutoAttach", auto_attach_params()),
   595	                    ] {
   596	                        self.id += 1;
   597	                        let guard_id = self.id;
   598	                        self.guard_enable.insert(guard_id, session.to_owned());
   599	                        let guard = json!({"id":guard_id,"method":method,"params":params,"sessionId":session});
   600	                        self.ws
   601	                            .send(Message::Text(guard.to_string().into()))
   602	                            .await
   603	                            .map_err(|_| "browser_protocol_error")?;
   604	                    }
   605	                }
   606	            }
   607	        }
   608	    }
   609	}
   610	
   611	fn benign_ack_error(kind: &str, error: &Value) -> bool {
   612	    let message = error["message"].as_str().unwrap_or("");
   613	    match kind {
   614	        "fetch" => {
   615	            message.contains("No resource with given identifier")
   616	                || message.contains("Target closed")
   617	                || message.contains("Invalid InterceptionId")
   618	        }
   619	        "resume" => message.contains("Target closed"),
   620	        _ => false,
   621	    }
   622	}
   623	
   624	fn recognized_navigation_error(error: &Value) -> bool {
   625	    let message = error["message"].as_str().unwrap_or("");
   626	    message.contains("Execution context was destroyed")
   627	        || message.contains("Cannot find context with specified id")
   628	}
   629	
   630	fn auto_attach_params() -> Value {
   631	    json!({"autoAttach":true,"waitForDebuggerOnStart":true,"flatten":true,"filter":[{"type":"page"},{"type":"iframe"},{"type":"worker"},{"type":"service_worker"},{"type":"shared_worker"}]})
   632	}
   633	
   634	fn fetch_params() -> Value {
   635	    json!({"patterns":[{"urlPattern":"*://azure-api.net/*","requestStage":"Request"},{"urlPattern":"*://*.azure-api.net/*","requestStage":"Request"},{"urlPattern":"*://azurewebsites.net/*","requestStage":"Request"},{"urlPattern":"*://*.azurewebsites.net/*","requestStage":"Request"},{"urlPattern":"*://binus.ac.id/*","requestStage":"Request"},{"urlPattern":"*://*.binus.ac.id/*","requestStage":"Request"}]})
   636	}
