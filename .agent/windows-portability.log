   439	async fn check_record(record: &CredentialRecord) -> bool {
   440	    let client = match reqwest::Client::builder()
   441	        .redirect(Policy::none())
   442	        .timeout(Duration::from_secs(20))
   443	        .build()
   444	    {
   445	        Ok(c) => c,
   446	        Err(_) => return false,
   447	    };
   448	    let request = match academic_period_request(record) {
   449	        Ok(r) => r,
   450	        Err(_) => return false,
   451	    };
   452	    if let Ok(response) = client.execute(request).await
   453	        && response.status().as_u16() == 200
   454	    {
   455	        return response
   456	            .json::<serde_json::Value>()
   457	            .await
   458	            .is_ok_and(|v| v.is_array());
   459	    }
   460	    false
   461	}
