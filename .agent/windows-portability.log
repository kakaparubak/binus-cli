   442	struct Browser(Child);
   443	impl Drop for Browser {
   444	    fn drop(&mut self) {
   445	        #[cfg(target_os = "linux")]
   446	        if let Some(pid) = rustix::process::Pid::from_raw(self.0.id() as i32) {
   447	            let _ = rustix::process::kill_process_group(pid, rustix::process::Signal::TERM);
   448	            std::thread::sleep(Duration::from_millis(100));
   449	            let _ = rustix::process::kill_process_group(pid, rustix::process::Signal::KILL);
   450	        }
   451	        let _ = self.0.kill();
   452	        let _ = self.0.wait();
   453	    }
   454	}
