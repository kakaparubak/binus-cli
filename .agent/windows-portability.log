   320	fn remove_record_file_unlocked(path: &Path) -> Result<bool, &'static str> {
   321	    if !matches!(
   322	        path.file_name().and_then(|n| n.to_str()),
   323	        Some("credentials.json" | "credentials.captured.json")
   324	    ) {
   325	        return Err("storage_error");
   326	    }
   327	    let dir = match secure_parent(path, false) {
   328	        Ok(fd) => fd,
   329	        Err("not_logged_in") => return Ok(false),
   330	        Err(_) => return Err("storage_error"),
   331	    };
   332	    validate_private_app_dir(&dir)?;
   333	    let name = path
   334	        .file_name()
   335	        .and_then(|n| n.to_str())
   336	        .ok_or("storage_error")?;
   337	    let meta = match rfs::statat(&dir, name, AtFlags::SYMLINK_NOFOLLOW) {
   338	        Ok(meta) => meta,
   339	        Err(e) if e == rustix::io::Errno::NOENT => return Ok(false),
   340	        Err(_) => return Err("storage_error"),
   341	    };
   342	    if meta.st_mode & 0o170000 != 0o100000
   343	        || meta.st_uid != rustix::process::geteuid().as_raw()
   344	        || meta.st_mode & 0o077 != 0
   345	    {
   346	        return Err("storage_error");
   347	    }
   348	    rfs::unlinkat(&dir, name, AtFlags::empty()).map_err(|_| "storage_error")?;
   349	    Ok(true)
   350	}
   351	
   352	fn validate_private_app_dir(dir: &std::os::fd::OwnedFd) -> Result<(), &'static str> {
   353	    let meta = rfs::fstat(dir).map_err(|_| "storage_error")?;
   354	    if meta.st_mode & 0o170000 != 0o040000
   355	        || meta.st_uid != rustix::process::geteuid().as_raw()
   356	        || meta.st_mode & 0o077 != 0
   357	    {
   358	        return Err("storage_error");
   359	    }
   360	    Ok(())
   361	}
   362	
   363	pub fn promote_verified_candidate(
   364	    primary: &Path,
   365	    candidate: &Path,
   366	    verified: &CredentialRecord,
   367	) -> Result<bool, &'static str> {
   368	    let _lock = storage_lock(primary, true)?;
   369	    let record = load_record(candidate)?;
   370	    if serde_json::to_vec(&record).ok() != serde_json::to_vec(verified).ok() {
   371	        return Err("candidate_changed");
   372	    }
   373	    store_record_unlocked(primary, verified)?;
   374	    remove_record_file_unlocked(candidate)?;
   375	    Ok(true)
   376	}
   377	
   378	fn storage_lock(path: &Path, create: bool) -> Result<std::os::fd::OwnedFd, &'static str> {
   379	    let dir = secure_parent(path, create)?;
   380	    let meta = rfs::fstat(&dir).map_err(|_| "storage_error")?;
   381	    if meta.st_uid != rustix::process::geteuid().as_raw() || meta.st_mode & 0o170000 != 0o040000 {
   382	        return Err("storage_error");
   383	    }
   384	    rfs::fchmod(&dir, Mode::from_raw_mode(0o700)).map_err(|_| "storage_error")?;
   385	    validate_private_app_dir(&dir)?;
   386	    let fd = rfs::openat(
   387	        &dir,
   388	        ".auth-spike.lock",
   389	        OFlags::RDWR | OFlags::CREATE | OFlags::NOFOLLOW | OFlags::CLOEXEC,
   390	        Mode::from_raw_mode(0o600),
   391	    )
   392	    .map_err(|_| "storage_error")?;
   393	    let meta = rfs::fstat(&fd).map_err(|_| "storage_error")?;
   394	    if meta.st_mode & 0o170000 != 0o100000
   395	        || meta.st_uid != rustix::process::geteuid().as_raw()
   396	        || meta.st_mode & 0o077 != 0
   397	    {
   398	        return Err("storage_error");
   399	    }
   400	    rfs::flock(&fd, rustix::fs::FlockOperation::LockExclusive).map_err(|_| "storage_error")?;
   401	    Ok(fd)
   402	}
