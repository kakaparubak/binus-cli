        let mut inner = Mem::default();
        let r = rec("verified");
        store(&mut inner, Key::Candidate, &r).unwrap();
        let mut api = LockedApi {
            inner,
            held: &held,
            calls: 0,
        };
        let result = with_lock(
            || {
                held.set(true);
                Ok(Guard(&held))
            },
            || promote(&mut api, &r),
        );
        assert_eq!(result, Ok(true));
        assert_eq!(api.calls, 3);
        assert!(!held.get());
    }
}

#[cfg(all(test, windows))]
mod native_tests {
    use super::*;
    #[test]
    fn native_targets_are_fixed_versioned_user_credentials() {
        assert_eq!(Key::Primary.target(), "BinusAuthSpike.v1.credentials");
        assert_eq!(
            Key::Candidate.target(),
            "BinusAuthSpike.v1.credentials.captured"
        );
        assert_eq!(MAX_BLOB, 2560);
    }
}
