+        let nanos = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap()
+            .as_nanos();
+        let namespace = format!(
+            "BinusAuthSpike.test.{}.{}.{}",
+            std::process::id(),
+            nanos,
+            NEXT_NAMESPACE.fetch_add(1, Ordering::Relaxed)
+        );
+        native::WinApi::isolated(namespace).unwrap()
+    }
+
