+            store(api, Key::Primary, &expected)?;
+            assert_record_eq(&load(api, Key::Primary)?, &expected);
+            assert!(api.delete(Key::Primary)?);
+            assert!(matches!(load(api, Key::Primary), Err("not_logged_in")));
+            Ok(())
+        })
+        .unwrap();
+    }
