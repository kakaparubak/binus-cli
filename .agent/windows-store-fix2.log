+            ] {
+                if read_target(&target)?.is_some() {
+                    return Err("storage_error");
+                }
+            }
+            Ok(Self {
+                namespace: Some(namespace),
+                created: Vec::new(),
+            })
+        }
+        #[cfg(test)]
+        pub(super) fn unrelated_target(&self) -> String {

