+        assert!(key(Path::new("/anything/credentials.captured.json")).is_ok());
+        assert_eq!(key(Path::new("/anything/other.json")), Err("storage_error"));
+    }
+
+    #[test]
+    fn lock_covers_candidate_read_compare_primary_write_and_delete() {
+        use std::cell::Cell;
+        struct Guard<'a>(&'a Cell<bool>);
+        impl Drop for Guard<'_> { fn drop(&mut self) { self.0.set(false); } }
+        struct LockedApi<'a> { inner: Mem, held: &'a Cell<bool>, calls: usize }
+        impl Api for LockedApi<'_> {
+            fn read(&mut self,k:Key)->Result<Option<Vec<u8>>,&'static str>{assert!(self.held.get());self.calls+=1;self.inner.read(k)}
+            fn write(&mut self,k:Key,b:&[u8])->Result<(), &'static str>{assert!(self.held.get());self.calls+=1;self.inner.write(k,b)}
+            fn delete(&mut self,k:Key)->Result<bool,&'static str>{assert!(self.held.get());self.calls+=1;self.inner.delete(k)}
+        }
+        let held=Cell::new(false); let mut inner=Mem::default(); let r=rec("verified"); store(&mut inner,Key::Candidate,&r).unwrap();
+        let mut api=LockedApi{inner,held:&held,calls:0};
+        let result=with_lock(|| { held.set(true); Ok(Guard(&held)) }, || promote(&mut api,&r));
+        assert_eq!(result,Ok(true)); assert_eq!(api.calls,3); assert!(!held.get());
+    }
+}
