+    fn rec(account: &str) -> CredentialRecord {
+        CredentialRecord {
+            account: account.into(),
+            access_token: "a".repeat(16),
+            refresh_token: "b".repeat(16),
+            role: crate::RoleContext {
+                academic_career: "x".into(),
+                institution: "x".into(),
+                name: "x".into(),
+                role_id: "x".into(),
+                organization_id: "x".into(),
+            },
+        }
