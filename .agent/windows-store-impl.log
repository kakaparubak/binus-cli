use crate::{
    CredentialRecord, academic_period_request, capture, load_preferred_record,
    promote_verified_candidate, remove_spike_artifacts, sanitized_status, store_record,
};
use clap::{Parser, Subcommand};
use reqwest::redirect::Policy;
use serde_json::json;
use std::{path::PathBuf, process::ExitCode, time::Duration};

#[derive(Parser)]
#[command(
    name = "binus-auth-spike",
    about = "Experimental BINUS authentication feasibility spike"
)]
struct Cli {
    #[arg(long, global = true)]
    allow_plaintext_file: bool,
    #[arg(long, global = true, default_value_t = 300)]
    timeout_seconds: u64,
    #[command(subcommand)]
    command: Command,
    #[arg(skip)]
    program: Option<String>,
}
#[derive(Subcommand)]
enum Command {
    Auth {
        #[command(subcommand)]
        action: Action,
    },
    Courses {
        #[command(subcommand)]
        action: CoursesAction,
    },
    Forums {
        #[command(subcommand)]
        action: ForumsAction,
    },
}
#[derive(Subcommand)]
enum ForumsAction {
    Threads {
        #[command(subcommand)]
        action: ForumThreadsAction,
    },
}
#[derive(Subcommand)]
enum ForumThreadsAction {
    List {
        #[arg(long, required=true, value_parser=parse_class)]
        class: String,
        #[arg(long,required=true,value_parser=parse_session_id)]
        session: String,
    },
    Show {
        #[arg(value_parser=parse_session_id)]
        thread_id: String,
        #[arg(long,required=true,value_parser=parse_class)]
        class: String,
    },
}
#[derive(Subcommand)]
enum CoursesAction {
    Periods,
    List {
        #[arg(long, required = true, value_parser = parse_period)]
        period: String,
    },
    Sessions {
        #[command(subcommand)]
        action: SessionsAction,
    },
}
#[derive(Subcommand)]
enum SessionsAction {
    List {
        #[arg(long, required=true, value_parser=parse_class)]
        class: String,
    },
    Show {
        #[arg(value_parser = parse_session_id)]
        session_id: String,
    },
}
#[derive(Subcommand)]
enum Action {
    Login,
    Status,
    Check,
    Logout,
}

fn credentials_path() -> PathBuf {
    let base = std::env::var_os("XDG_CONFIG_HOME")
        .map(PathBuf::from)
        .unwrap_or_else(|| {
            PathBuf::from(std::env::var_os("HOME").unwrap_or_default()).join(".config")
        });
    base.join("binus-auth-spike").join("credentials.json")
}
fn parse_period(value: &str) -> Result<String, String> {
    if crate::courses::safe_segment(value) {
        Ok(value.to_owned())
    } else {
        Err("period must be a safe catalog identifier".into())
    }
}
fn parse_class(value: &str) -> Result<String, String> {
    if crate::courses::safe_segment(value) {
        Ok(value.into())
    } else {
        Err("class must be a safe catalog identifier".into())
    }
}
fn parse_session_id(value: &str) -> Result<String, String> {
    if crate::courses::safe_segment(value) {
        Ok(value.to_owned())
    } else {
        Err("session ID must be a safe catalog identifier".into())
    }
}

pub async fn run() -> ExitCode {
    let mut cli = Cli::parse();
    let program = std::env::args()
        .next()
        .and_then(|s| {
            std::path::PathBuf::from(s)
                .file_name()
