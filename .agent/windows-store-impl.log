        assert!(preferred(&mut m).unwrap().1); assert!(promote(&mut m,&r).unwrap()); assert!(!preferred(&mut m).unwrap().1);
        store(&mut m,Key::Candidate,&old).unwrap(); assert_eq!(promote(&mut m,&r),Err("candidate_changed"));
        m.fail_write=true; assert_eq!(promote(&mut m,&old),Err("storage_error")); assert!(load(&mut m,Key::Candidate).is_ok()); assert_eq!(load(&mut m,Key::Primary).unwrap().account,"candidate");
        m.map.remove(&Key::Candidate); assert!(!preferred(&mut m).unwrap().1);
    }
    #[test] fn logout_attempts_both(){let mut m=Mem::default();m.map.insert(Key::Primary,vec![1]);m.map.insert(Key::Candidate,vec![1]);m.fail_delete=true;assert_eq!(logout(&mut m),Err("storage_error"));assert_eq!(m.map.len(),2);assert_eq!(m.reads,0);}
    #[test] fn only_closed_keys_are_supported(){assert!(key(Path::new("/anything/credentials.json")).is_ok());assert!(key(Path::new("/anything/credentials.captured.json")).is_ok());assert_eq!(key(Path::new("/anything/other.json")),Err("storage_error"));}'"''')
