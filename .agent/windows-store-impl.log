+    #[test]
+    fn engine_roundtrip_and_exact_size_preflight() {
+        let mut m = Mem::default();
+        let old = rec("old");
+        store(&mut m, Key::Primary, &old).unwrap();
+        let mut exact = rec("");
+        let mut n = 0;
+        loop {
+            exact.account.push('x');
