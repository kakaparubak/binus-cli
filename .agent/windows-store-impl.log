+    #[test]
+    fn native_targets_are_fixed_versioned_user_credentials() {
+        assert_eq!(Key::Primary.target(), "BinusAuthSpike.v1.credentials");
+        assert_eq!(
+            Key::Candidate.target(),
+            "BinusAuthSpike.v1.credentials.captured"
+        );
+        assert_eq!(MAX_BLOB, 2560);
+    }
 }

