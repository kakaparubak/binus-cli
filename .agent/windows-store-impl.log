+        m.map.insert(Key::Primary, vec![1]);
+        m.map.insert(Key::Candidate, vec![1]);
+        m.fail_delete = true;
+        assert_eq!(logout(&mut m), Err("storage_error"));
+        assert_eq!(m.map.len(), 2);
+        assert_eq!(m.reads, 0);
+    }
