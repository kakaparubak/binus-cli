+    fn lock_covers_candidate_read_compare_primary_write_and_delete() {
+        use std::cell::Cell;
+        struct Guard<'a>(&'a Cell<bool>);
+        impl Drop for Guard<'_> {
+            fn drop(&mut self) {
+                self.0.set(false);
+            }
+        }
+        struct LockedApi<'a> {
+            inner: Mem,
+            held: &'a Cell<bool>,
+            calls: usize,
+        }
+        impl Api for LockedApi<'_> {
+            fn read(&mut self, k: Key) -> Result<Option<Vec<u8>>, &'static str> {
