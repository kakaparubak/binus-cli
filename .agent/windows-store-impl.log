+        assert_eq!(load(&mut m, Key::Primary).unwrap().account, "candidate");
+        m.map.remove(&Key::Candidate);
+        assert!(!preferred(&mut m).unwrap().1);
+    }
+    #[test]
+    fn logout_attempts_both() {
