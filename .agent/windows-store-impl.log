+        let mut api=LockedApi{inner,held:&held,calls:0};
+        let result=with_lock(|| { held.set(true); Ok(Guard(&held)) }, || promote(&mut api,&r));
+        assert_eq!(result,Ok(true)); assert_eq!(api.calls,3); assert!(!held.get());
+    }
