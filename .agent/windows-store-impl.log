        let mut m=Mem::default(); let old=rec(\"old\"); store(&mut m,Key::Primary,&old).unwrap();
        let mut exact=rec(\"\");
        let mut n=0; loop { exact.account.push('x'); n+=1; if serde_json::to_vec(&exact).unwrap().len() >= MAX_BLOB { break; } }
        exact.account.pop(); n-=1; // derive the true serialized boundary from the record
        let base=serde_json::to_vec(&exact).unwrap().len();
        exact.account.push_str(&\"x\".repeat(MAX_BLOB-base));
